# Copy to .env and fill in real values. .env is gitignored; this file is not.
#   cp .env.example .env

# GUI login. There is no first-run prompt — set this before starting.
# Matches the code's fallback in main.py; they were once change-me and
# changeme, which is a five-minute confusion waiting to happen.
ADMIN_PASSWORD=changeme

# Home Assistant, used only for entity dropdowns and the live preview.
# Both must be set or the GUI reports "not configured" and falls back to
# typing entity IDs by hand. Use an IP: homeassistant.local generally does
# not resolve from inside the container.
HA_URL=http://192.168.1.10:8123

# Long-lived access token. Use a separate one from the panels' tokens so
# revoking a panel doesn't take down the GUI.
HA_TOKEN=
