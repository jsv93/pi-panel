# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Server runtime state — ./data is the compose bind mount for /data,
# holding panels.db and the panel.html copy used by the live preview.
data/
*.db
*.db-journal
*.db-wal
*.db-shm

# Secrets. Panels keep secrets.json beside their cached config; ESPHome
# uses secrets.yaml. Neither belongs in the repo.
secrets.json
secrets.yaml
.env

# ESPHome build output
.esphome/
build/
sdkconfig
sdkconfig.*
!sdkconfig.defaults

# Editor / OS
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/
